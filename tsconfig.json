{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/unit_tests/**/*.ts",
    "tests/unit_tests/**/*.tsx",
    "tests/integration_tests/**/*.ts",
    "tests/integration_tests/**/*.tsx",
    "tests/component_tests/**/*.ts",
    "tests/component_tests/**/*.tsx",
    "tests/api_tests/**/*.ts",
    "tests/accessibility_tests/**/*.ts",
    "tests/e2e_tests/**/*.ts",
    "tests/e2e_tests/**/*.tsx",
    "vitest.config.mts",
    "playwright.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
